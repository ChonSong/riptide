# Riptide Environment Configuration
# Copy to .env and customize for your deployment

# ─────────────────────────────────────────────────────────────────────────────
# GitHub App
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_APP_ID=4262983
GITHUB_PRIVATE_KEY_PATH=/home/sc/workspace/riptide/github-private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_SLUG=riptide-review

# ─────────────────────────────────────────────────────────────────────────────
# Data & Storage
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_DATA_DIR=/home/sc/.local/share/riptide
RIPTIDE_STATE_DB=/home/sc/.local/share/riptide/state.db

# ─────────────────────────────────────────────────────────────────────────────
# Ollama (local LLM for Companion)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REVIEW_MODEL=qwen2.5-coder:7b

# ─────────────────────────────────────────────────────────────────────────────
# Companion (Bot 1: TL;DR posts on PRs)
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_COMPANION_REPOS=ChonSong/riptide,ChonSong/hermes-webui,ChonSong/hermes-webui-extensions,codeovertcp/gto-wizard-clone-v2
RIPTIDE_COMPANION_MODEL=qwen2.5-coder:7b
COMPANION_ENABLE_GRAPHIFY=1
COMPANION_ENABLE_HUMOR=1
COMPANION_ENABLE_DIAGRAM=1
GRAFIPHY_ENABLE=1

# ─────────────────────────────────────────────────────────────────────────────
# Deep-think (Bot 2: Review Bot — autonomous deep-think PR analysis)
# ─────────────────────────────────────────────────────────────────────────────
# The .env pin is authoritative — the app spawns review sessions with exactly
# these values and the review sign-off names this model. Do not prefix the model
# with `custom:` and do not assume the code defaults (LongCat-2.0/longcat) are in
# use; they are fallbacks for a missing .env only.
RIPTIDE_DEEPTHINK_MODEL=deepseek-v4-flash
RIPTIDE_DEEPTHINK_PROVIDER=deepseek
RIPTIDE_WATCHED_REPOS=ChonSong/riptide,ChonSong/hermes-webui,ChonSong/hermes-webui-extensions,ChonSong/seans-reporepo,ChonSong/pr-review,ChonSong/everything-claude-code,codeovertcp/gto-wizard-clone-v2,nesquena/hermes-webui
RIPTIDE_OUR_USERNAME=ChonSong
RIPTIDE_OUR_ORG=ChonSong
RIPTIDE_STALENESS_MINUTES=30
RIPTIDE_MIN_LOC_CHANGED=100

# ─────────────────────────────────────────────────────────────────────────────
# Fixer (Bot 2b: Autonomous fix)
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_FIX_MODEL=deepseek-v4-flash
RIPTIDE_FIX_PROVIDER=deepseek
RIPTIDE_WORKSPACE_ROOT=/home/sc/workspace

# ─────────────────────────────────────────────────────────────────────────────
# Proofshotter (Bot 3: Visual verification)
# ─────────────────────────────────────────────────────────────────────────────
# Prerequisite: RIPTIDE_PROOFSHOT_CLI must point at an existing proofshot CLI
# (checkout + `cli.py`). If it is missing, or the dev instance is not serving,
# captures are skipped — never faked.
RIPTIDE_PROOFSHOT_STALENESS_MINUTES=10
RIPTIDE_PROOFSHOT_TIMEOUT=180
RIPTIDE_PROOFSHOT_URL=http://localhost:8788
RIPTIDE_PROOFSHOT_CLI=/path/to/proofshot/cli.py

# ─────────────────────────────────────────────────────────────────────────────
# Visual Regression (Bot 4: @riptide-bot visual — GitHub Actions dispatch)
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_VISUAL_REPO=ChonSong/hermes-webui-tests
RIPTIDE_VISUAL_WORKFLOW=visual.yml

# ─────────────────────────────────────────────────────────────────────────────
# Poller (GitHub poller for upstream PRs/issues)
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_POLLER_LOOKBACK=3
RIPTIDE_POLLER_MAX=20
# Comma-separated repos; when unset the poller skips PR review discovery.
# The cron scripts (~/.hermes/scripts/riptide-review-poll.sh) must source this
# file, otherwise the poller uses the code defaults instead of this pin.
RIPTIDE_POLLER_REPOS=

# ─────────────────────────────────────────────────────────────────────────────
# Auto-deploy (webhook triggers scripts/deploy.sh on merge to this branch)
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_DEPLOY_BRANCH=main
# Production is a dedicated worktree pinned to main (systemd drop-in
# riptide.service.d/pin-prod-checkout.conf): deploys pull and restart THAT
# checkout, never whichever branch a dev tree happens to have checked out.
RIPTIDE_DEPLOY_SCRIPT=/home/sc/workspace/riptide-prod/scripts/deploy.sh
RIPTIDE_DEPLOY_REPO=/home/sc/workspace/riptide-prod
# Overridable so deploy.sh can be exercised without restarting the real service:
# RIPTIDE_DEPLOY_RESTART_CMD=systemctl --user restart riptide.service
# RIPTIDE_DEPLOY_STATUS_CMD=systemctl --user is-active --quiet riptide.service

# ─────────────────────────────────────────────────────────────────────────────
# Orchestrator
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_T0_MAX_CONCURRENT=3

# ─────────────────────────────────────────────────────────────────────────────
# Graphify
# ─────────────────────────────────────────────────────────────────────────────
GRAPHIFY_CWD=/home/sc/workspace/riptide
GRAPHIFY_BIN=/home/sc/.local/bin/graphify

# ─────────────────────────────────────────────────────────────────────────────
# Server / Networking
# ─────────────────────────────────────────────────────────────────────────────
RIPTIDE_SERVER_PORT=8477
RIPTIDE_SERVER_HOST=0.0.0.0
