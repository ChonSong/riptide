    { "type": "text", "id": "t-cf-11", "x": 60, "y": 1114, "width": 330, "height": 18, "text": "OUT: body (str) — full markdown comment", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "comment-format" },
    { "type": "rectangle", "id": "comment-review", "x": 420, "y": 935, "width": 350, "height": 180, "strokeColor": "#1e1e1e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "roundness": { "type": 3 } },
