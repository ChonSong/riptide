    { "type": "rectangle", "id": "comment-post", "x": 790, "y": 935, "width": 350, "height": 140, "strokeColor": "#1e1e1e", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "roundness": { "type": 3 } },
