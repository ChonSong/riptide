    { "type": "text", "id": "t-cr-3", "x": 430, "y": 986, "width": 330, "height": 18, "text": "  findings[] — {severity, title,", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "comment-review" },
