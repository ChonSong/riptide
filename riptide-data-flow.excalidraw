    { "type": "text", "id": "t-cs-10", "x": 60, "y": 866, "width": 330, "height": 18, "text": "RETRY: 3x (5s/10s/20s backoff)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "cron-spawn" },
    { "type": "rectangle", "id": "session-pipeline", "x": 420, "y": 705, "width": 350, "height": 180, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "roundness": { "type": 3 } },
    { "type": "text", "id": "t-sp-10", "x": 430, "y": 715, "width": 330, "height": 20, "text": "Spawned Session Pipeline", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-11", "x": 430, "y": 738, "width": 330, "height": 18, "text": "1. Pre-flight: clone repo at HEAD", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-12", "x": 430, "y": 754, "width": 330, "height": 18, "text": "2. Graphify blast radius", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-13", "x": 430, "y": 770, "width": 330, "height": 18, "text": "3. Verification gate (per-finding)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-14", "x": 430, "y": 786, "width": 330, "height": 18, "text": "4. Implementation (valid only)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-15", "x": 430, "y": 802, "width": 330, "height": 18, "text": "5. Test + validate (no push on red)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-16", "x": 430, "y": 818, "width": 330, "height": 18, "text": "6. Push (if push_eligible)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-17", "x": 430, "y": 834, "width": 330, "height": 18, "text": "7. Summary comment + verdicts", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-18", "x": 430, "y": 850, "width": 330, "height": 18, "text": "8. Cleanup: mark_complete/failed", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "t-sp-19", "x": 430, "y": 866, "width": 330, "height": 18, "text": "   (NOTE: DB lock may block cleanup)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "session-pipeline" },
    { "type": "text", "id": "sec-comment", "x": 50, "y": 910, "width": 500, "height": 20, "text": "5. COMMENT ASSEMBLY (_format_comment + assemble_review_body)", "fontSize": 18, "fontFamily": 1, "strokeColor": "#1e1e1e" },
