    { "type": "rectangle", "id": "gap-2", "x": 420, "y": 1165, "width": 350, "height": 100, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "roundness": { "type": 3 } },
    { "type": "text", "id": "t-gap-2", "x": 430, "y": 1175, "width": 330, "height": 20, "text": "GAP: No trace/span IDs", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "containerId": "gap-2" },
    { "type": "text", "id": "t-gap-2b", "x": 430, "y": 1198, "width": 330, "height": 18, "text": "delivery_id not propagated to:", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-2" },
    { "type": "text", "id": "t-gap-2c", "x": 430, "y": 1214, "width": 330, "height": 18, "text": "  - spawned Hermes cron jobs", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-2" },
    { "type": "text", "id": "t-gap-2d", "x": 430, "y": 1230, "width": 330, "height": 18, "text": "  - background worker threads", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-2" },
    { "type": "text", "id": "t-gap-2e", "x": 430, "y": 1246, "width": 330, "height": 18, "text": "  - subagent sessions", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-2" },
    { "type": "rectangle", "id": "gap-3", "x": 790, "y": 1165, "width": 350, "height": 100, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "roundness": { "type": 3 } },
    { "type": "text", "id": "t-gap-3", "x": 800, "y": 1175, "width": 330, "height": 20, "text": "GAP: DB lock contention", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "containerId": "gap-3" },
    { "type": "text", "id": "t-gap-3b", "x": 800, "y": 1198, "width": 330, "height": 18, "text": "Production server holds WAL", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-3" },
    { "type": "text", "id": "t-gap-3c", "x": 800, "y": 1214, "width": 330, "height": 18, "text": "  connections with 5s busy timeout", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-3" },
