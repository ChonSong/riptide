    { "type": "text", "id": "sec-cron", "x": 50, "y": 680, "width": 400, "height": 20, "text": "4. HERMES CRON → SPAWNED SESSION", "fontSize": 18, "fontFamily": 1, "strokeColor": "#1e1e1e" },
