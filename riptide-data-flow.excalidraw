    { "type": "text", "id": "sec-telemetry", "x": 50, "y": 1140, "width": 500, "height": 20, "text": "6. OBSERVABILITY GAPS & TELEMETRY IMPROVEMENTS", "fontSize": 18, "fontFamily": 1, "strokeColor": "#1e1e1e" },
    { "type": "rectangle", "id": "gap-1", "x": 50, "y": 1165, "width": 350, "height": 100, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "roundness": { "type": 3 } },
    { "type": "text", "id": "t-gap-1", "x": 60, "y": 1175, "width": 330, "height": 20, "text": "GAP: No structured metrics", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "containerId": "gap-1" },
    { "type": "text", "id": "t-gap-1b", "x": 60, "y": 1198, "width": 330, "height": 18, "text": "No counters/gauges for:", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-1" },
    { "type": "text", "id": "t-gap-1c", "x": 60, "y": 1214, "width": 330, "height": 18, "text": "  - spawn_success_total", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "gap-1" },
