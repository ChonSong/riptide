    { "type": "text", "id": "t-cs-8", "x": 60, "y": 834, "width": 330, "height": 18, "text": "--repeat 1 (one-shot)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "cron-spawn" },
