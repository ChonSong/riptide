    { "type": "text", "id": "t-cs-4", "x": 60, "y": 770, "width": 330, "height": 18, "text": "--skill deep-think", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "cron-spawn" },
