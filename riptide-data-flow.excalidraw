    { "type": "text", "id": "t-cp-3", "x": 800, "y": 984, "width": 330, "height": 18, "text": "  pr_number, body (markdown)", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "comment-post" },
    { "type": "text", "id": "t-cp-4", "x": 800, "y": 1006, "width": 330, "height": 18, "text": "METHOD: GitHubAppClient", "fontSize": 11, "fontFamily": 1, "strokeColor": "#757575", "containerId": "comment-post" },
